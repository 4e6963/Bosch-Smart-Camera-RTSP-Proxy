# All settings below are optional -- every one already has a working default
# baked into the binary. Uncomment and edit only the ones you want to override.

# --- OAuth client ---

# OAuth client id used to talk to Bosch's identity provider.
# Default: "residential_app".
# BOSCH_CLIENT_ID=residential_app

# OAuth client secret paired with BOSCH_CLIENT_ID (not a per-user secret, so the
# built-in default works out of the box; override only if Bosch ever rotates it).
# BOSCH_CLIENT_SECRET=yUmjfFutWfKbYOOficWFrcFeD14oFW0C

# --- TLS trust for the camera stream (Bosch private CA bundle) ---

# Path to a PEM file overriding the Bosch private-PKI root CA used to validate
# both the REST API and the camera's own TLS (see src/tls_relay.rs). The real
# root CA is embedded in the binary at compile time, so this is only needed if
# Bosch ever rotates it. Default: embedded (no file needed).
# BOSCH_CA_BUNDLE=./bosch-ca.pem

# Bring-up crutch ONLY: skip camera certificate verification entirely instead of
# validating against BOSCH_CA_BUNDLE. Do not use in production. Default: off (0).
# BOSCH_TLS_INSECURE=1

# --- Session persistence ---

# Where the rotated OAuth refresh token is persisted between runs. Seed it once
# via `bosch-cam-proxy login` (see README).
# Default: ./tokens.json
# TOKEN_STORE=./tokens.json

# --- Local RTSP server exposed to consumers (VLC / Frigate / ...) ---

# Local bind address for the RTSP server consumers connect to.
# Default: 0.0.0.0:8554
# RTSP_BIND=0.0.0.0:8554

# Default upstream route when a client's request URL does not specify one
# (append /local or /relay to the path to override per-request): local (direct
# LAN connection, high quality) | relay (Bosch's cloud relay, lower quality).
# Default: local
# RTSP_DEFAULT_ROUTE=local

# Relay the camera's audio track in addition to video. `0` to disable (video
# only). Default: on.
# RTSP_AUDIO=0

# Publish a "Connecting to camera..." placeholder clip while the real upstream
# ingest is starting (cold start takes several seconds, mostly the camera's own
# TLS handshake), so subscribers get instant playback instead of a blocked
# DESCRIBE -- see src/placeholder.rs. `0` to disable and just block until the
# real stream is ready. Default: on.
# RTSP_CONNECTING_PLACEHOLDER=0

# --- Logging ---

# Log filter (tracing EnvFilter syntax, e.g. bosch_cam_proxy=debug for verbose
# output, or a module path like bosch_cam_proxy::tls_relay=debug).
# Default: bosch_cam_proxy=info
# RUST_LOG=bosch_cam_proxy=info
